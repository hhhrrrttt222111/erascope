{
  "name": "erascope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node scripts/validate-eras.ts && node scripts/check-routing.ts && node scripts/check-freshness.ts",
    "validate:counts": "node scripts/check-counts.ts",
    "factcheck:report": "node scripts/factcheck-report.ts",
    "check:freshness": "node scripts/check-freshness.ts --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  }
}
